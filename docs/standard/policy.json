{
  "schema": "wellmanifest.docs/policy/v1",
  "id": "wellmanifest/docs",
  "version": "0.2.0",
  "document_schema": "wellmanifest.docs/document/v1",
  "adoption_schema": "wellmanifest.docs/adoption/v1",
  "profile": {
    "required_namespace": "subactor/",
    "docs_root": "docs",
    "index": "docs/README.md",
    "cross_repository_home": "subactor/docs",
    "organization_report_repository": "report",
    "repository_overrides": {
      "subactor/docs": {
        "docs_root": ".",
        "index": "README.md",
        "prefix": "architecture"
      }
    }
  },
  "kinds": {
    "information": {
      "directory": "information",
      "sections": [
        "purpose",
        "scope",
        "evidence",
        "content",
        "limitations",
        "next_actions"
      ]
    },
    "analysis": {
      "directory": "analysis",
      "sections": [
        "question",
        "scope",
        "method",
        "evidence",
        "facts",
        "hypotheses",
        "limitations",
        "recommendations"
      ]
    },
    "refactoring-plan": {
      "directory": "refactoring",
      "sections": [
        "goal",
        "current_state",
        "scope",
        "non_goals",
        "evidence",
        "target_design",
        "migration",
        "acceptance",
        "validation",
        "rollback",
        "risks",
        "ownership"
      ]
    },
    "decision": {
      "directory": "decisions",
      "sections": [
        "context",
        "evidence",
        "alternatives",
        "decision",
        "consequences",
        "validation",
        "supersedes"
      ]
    }
  },
  "metadata": {
    "schema": "string",
    "id": "slug",
    "kind": "kind",
    "version": "positive_integer",
    "title": "string",
    "status": "status",
    "owner": "string",
    "created": "date",
    "updated": "date",
    "review_after": "date",
    "source_revision": "sha40",
    "affected_repositories": "repositories",
    "evidence": "references"
  },
  "optional_metadata": {
    "scope": "scope"
  },
  "delivery_scopes": ["repository", "organization"],
  "statuses": [
    "draft",
    "proposed",
    "accepted",
    "implemented",
    "superseded"
  ],
  "forbidden_delivery_roots": [
    "project/",
    ".subactor/",
    ".git/",
    ".local/",
    "/tmp/"
  ],
  "adoption_scope": "managed-declared-and-base-changed-documents",
  "authority": "Documentation never grants execution, secret access, deployment or merge authority.",
  "discovery": {
    "organizational_names": [
      "README.md",
      "AGENTS.md",
      "GEMINI.md",
      "CLAUDE.md",
      "CHANGELOG.md",
      "TODO.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "CODE_OF_CONDUCT.md",
      "LICENSE.md"
    ],
    "organizational_paths": [
      "project/TICKETS.md"
    ],
    "organizational_prefixes": [
      ".governance/",
      ".github/",
      ".cursor/"
    ],
    "ticket_pattern": "^project/ticket-[0-9]{3}/[^/]+\\.md$"
  }
}
